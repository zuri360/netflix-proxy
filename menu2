#!/usr/bin/env bash
# Menú de gestión de netflix-proxy — se abre escribiendo: menu2

CONF=/etc/netflix-proxy-menu.conf
DIR=/root/netflix-proxy
DB=$DIR/auth/db/auth.db
IPS_DATA=/etc/netflix-proxy-ips.txt   # nombre:ip:expira(timestamp)

verde='\e[32m'; rojo='\e[31m'; amarillo='\e[33m'; negrita='\e[1m'; reset='\e[0m'

[[ $EUID -eq 0 ]] || { echo "Ejecutá menu2 como root."; exit 1; }
[[ -f $CONF ]] || { echo "Falta $CONF. Reinstalá con install.sh."; exit 1; }
. "$CONF"   # define IP y ADMIN_PASS

valid_ip() { [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; }
pausa()    { echo; read -rp "Enter para volver al menú..." _; }

# ============ ELIMINAR IPs EXPIRADAS (CON AWK) — solo manual, desde la opción 2 ============
check_and_clean_expired() {
    [[ -s $IPS_DATA ]] || { echo -e "${verde}No hay IPs expiradas.${reset}"; return 0; }
    local current_time; current_time=$(date +%s)

    awk -v current="$current_time" -F: '
    {
        if ($3 ~ /^[0-9]+$/) {
            if (current > $3) print "EXPIRADO:" $0
            else              print "VIGENTE:" $0
        } else {
            print "CORRUPTO:" $0
        }
    }' "$IPS_DATA" > /tmp/np_ips_analysis.tmp

    local expirados
    expirados=$(grep "^EXPIRADO:" /tmp/np_ips_analysis.tmp | sed 's/^EXPIRADO://')

    if [[ -z $expirados ]]; then
        echo -e "${verde}No hay IPs expiradas.${reset}"
        rm -f /tmp/np_ips_analysis.tmp
        return 0
    fi
    if [[ -n $expirados ]]; then
        while IFS=: read -r nom ip exp; do
            valid_ip "$ip" || continue
            echo -e "${rojo}Eliminada: ${nom} -> ${ip} (expiró $(date -d "@$exp" '+%d/%m/%Y %H:%M'))${reset}"
            sqlite3 "$DB" "DELETE FROM IPADDRS WHERE ipaddr='${ip}';"
            quitar_reglas_ip "$ip"
            echo "$(date '+%d/%m/%Y %H:%M') VENCIDA: ${nom} -> ${ip} (expiró $(date -d "@$exp" '+%d/%m/%Y %H:%M'))" >> /var/log/menu2-expira.log
        done <<< "$expirados"
        netfilter-persistent save >/dev/null 2>&1
    fi

    # Se quedan solo las vigentes (las corruptas también se descartan)
    grep "^VIGENTE:" /tmp/np_ips_analysis.tmp | sed 's/^VIGENTE://' > "${IPS_DATA}.tmp"
    mv "${IPS_DATA}.tmp" "$IPS_DATA"
    rm -f /tmp/np_ips_analysis.tmp
}

agregar_ip() {
    read -rp "IP a autorizar: " nueva
    nueva=$(echo "$nueva" | tr -d ' ')
    valid_ip "$nueva" || { echo -e "${rojo}IP no válida.${reset}"; return; }

    read -rp "Nombre: " nombre
    nombre=$(echo "$nombre" | tr -d ":'|\"" | sed 's/^ *//;s/ *$//')
    [[ -n $nombre ]] || { echo -e "${rojo}El nombre no puede estar vacío.${reset}"; return; }

    read -rp "Días: " dias
    [[ $dias =~ ^[0-9]+$ && $dias -gt 0 ]] || { echo -e "${rojo}Días inválidos (número mayor a 0).${reset}"; return; }

    curl -s -o /dev/null "http://${IP}:8080/autoadd?ip=${nueva}&username=admin&password=${ADMIN_PASS}"
    # El panel a veces no aplica la regla en el firewall: se asegura acá
    if ! iptables -t nat -C PREROUTING -s "${nueva}/32" -i eth0 -j ACCEPT 2>/dev/null; then
        iptables -t nat -I PREROUTING -s "${nueva}/32" -i eth0 -j ACCEPT
    fi
    # DNS por TCP (necesario cuando la IP es un VPS de túnel con DNS Forwarding)
    if ! iptables -C INPUT -s "${nueva}/32" -p tcp --dport 53 -j ACCEPT 2>/dev/null; then
        iptables -I INPUT -s "${nueva}/32" -p tcp --dport 53 -j ACCEPT
    fi
    netfilter-persistent save >/dev/null 2>&1

    # Guardar expiración (timestamp en segundos). Si la IP ya estaba, se reemplaza (renovar)
    local now expiration_date exp_date
    now=$(date +%s)
    expiration_date=$((now + (dias * 86400)))
    exp_date=$(date -d "@$expiration_date" '+%d/%m/%Y %H:%M')
    touch "$IPS_DATA"
    awk -F: -v ip="$nueva" '$2 != ip' "$IPS_DATA" > "${IPS_DATA}.tmp" && mv "${IPS_DATA}.tmp" "$IPS_DATA"
    echo "${nombre}:${nueva}:${expiration_date}" >> "$IPS_DATA"

    if sqlite3 "$DB" "SELECT 1 FROM IPADDRS WHERE ipaddr='${nueva}' LIMIT 1;" | grep -q 1; then
        echo -e "${verde}IP ${nueva} (${nombre}) autorizada. Expira: ${exp_date} (${dias} días).${reset}"
    else
        echo -e "${amarillo}Firewall OK, pero el panel no la registró. Revisá la contraseña en ${CONF}.${reset}"
    fi
}

ver_ips() {
    local current_time; current_time=$(date +%s)
    echo -e "${negrita}IPs autorizadas:${reset}"
    printf "%-4s %-12s %-20s %-16s %s\n" "ID" "Nombre" "Creada" "IP" "Expira"
    printf "%-4s %-12s %-20s %-16s %s\n" "--" "------" "-------------------" "---------------" "------"
    sqlite3 -separator '|' "$DB" "SELECT ID, created, ipaddr FROM IPADDRS ORDER BY ID;" |
    while IFS='|' read -r id creada ip; do
        local linea nom exp_time estado
        linea=$(awk -F: -v ip="$ip" '$2 == ip' "$IPS_DATA" 2>/dev/null | tail -1)
        nom=$(echo "$linea" | cut -d: -f1); exp_time=$(echo "$linea" | cut -d: -f3)
        [[ -n $nom ]] || nom="-"

        if [[ $exp_time =~ ^[0-9]+$ ]]; then
            if (( current_time > exp_time )); then
                estado="${rojo}(EXPIRADO)${reset}"
            else
                local days_left hours_left minutes_left
                days_left=$(( (exp_time - current_time) / 86400 ))
                hours_left=$(( ((exp_time - current_time) % 86400) / 3600 ))
                minutes_left=$(( ((exp_time - current_time) % 3600) / 60 ))
                if (( days_left > 0 )); then
                    # Redondeo hacia arriba: una IP recién cargada por 24 días muestra 24, no 23
                    days_left=$(( (exp_time - current_time + 86399) / 86400 ))
                    estado="${verde}(${days_left} DIAS RESTANTES)${reset}"
                elif (( hours_left > 0 )); then
                    estado="${amarillo}(${hours_left} HORAS ${minutes_left} MINUTOS RESTANTES)${reset}"
                else
                    estado="${amarillo}(${minutes_left} MINUTOS RESTANTES)${reset}"
                fi
            fi
        else
            estado="${amarillo}(SIN EXPIRACION)${reset}"
        fi
        printf "%-4s %-12s %-20s %-16s %b\n" "$id" "${nom:0:12}" "$creada" "$ip" "$estado"
    done
}

# Guarda/actualiza la línea nombre:ip:expira de una IP
guardar_ip_data() {
    local nom=$1 ip=$2 exp=$3
    touch "$IPS_DATA"
    awk -F: -v ip="$ip" '$2 != ip' "$IPS_DATA" > "${IPS_DATA}.tmp" && mv "${IPS_DATA}.tmp" "$IPS_DATA"
    echo "${nom}:${ip}:${exp}" >> "$IPS_DATA"
}

# Pide un ID, nombre o IP y deja la IP encontrada en IP_SEL (devuelve 1 si no existe)
buscar_ip() {
    IP_SEL=""
    local ip="" sel x
    read -rp "$1" sel
    sel=$(echo "$sel" | tr -d ":'|\"" | sed 's/^ *//;s/ *$//')
    [[ -n $sel ]] || { echo "Cancelado."; return 1; }
    if [[ $sel =~ ^[0-9]+$ ]]; then
        ip=$(sqlite3 "$DB" "SELECT ipaddr FROM IPADDRS WHERE ID=${sel} LIMIT 1;")
    elif valid_ip "$sel"; then
        ip=$(sqlite3 "$DB" "SELECT ipaddr FROM IPADDRS WHERE ipaddr='${sel}' LIMIT 1;")
    else
        # Búsqueda por nombre (sin distinguir mayúsculas/minúsculas)
        local -a encontradas
        mapfile -t encontradas < <(awk -F: -v n="${sel,,}" 'tolower($1) == n {print $2}' "$IPS_DATA" 2>/dev/null)
        if [[ ${#encontradas[@]} -gt 1 ]]; then
            echo -e "${amarillo}Hay ${#encontradas[@]} IPs con el nombre '${sel}':${reset}"
            local x
            for x in "${encontradas[@]}"; do
                echo "  $(sqlite3 "$DB" "SELECT ID FROM IPADDRS WHERE ipaddr='${x}' LIMIT 1;")  ${x}"
            done
            read -rp "Escribí el ID o la IP: " sel
            sel=$(echo "$sel" | tr -d ' ')
            if [[ $sel =~ ^[0-9]+$ ]]; then
                ip=$(sqlite3 "$DB" "SELECT ipaddr FROM IPADDRS WHERE ID=${sel} LIMIT 1;")
            elif valid_ip "$sel"; then
                ip=$(sqlite3 "$DB" "SELECT ipaddr FROM IPADDRS WHERE ipaddr='${sel}' LIMIT 1;")
            fi
        elif [[ ${#encontradas[@]} -eq 1 ]]; then
            ip=$(sqlite3 "$DB" "SELECT ipaddr FROM IPADDRS WHERE ipaddr='${encontradas[0]}' LIMIT 1;")
        fi
    fi
    [[ -n $ip ]] || { echo -e "${rojo}No existe ese ID, nombre o IP en la lista.${reset}"; return 1; }
    IP_SEL=$ip
}

# ============ EDITAR IP EXISTENTE (nombre / días de vencimiento) ============
editar_ip() {
    local ip
    buscar_ip "ID, NOMBRE O IP A EDITAR: " || return
    ip=$IP_SEL

    local linea nom exp_time now exp_txt
    linea=$(awk -F: -v ip="$ip" '$2 == ip' "$IPS_DATA" 2>/dev/null | tail -1)
    nom=$(echo "$linea" | cut -d: -f1); exp_time=$(echo "$linea" | cut -d: -f3)
    now=$(date +%s)
    if [[ $exp_time =~ ^[0-9]+$ ]]; then
        exp_txt=$(date -d "@$exp_time" '+%d/%m/%Y %H:%M')
        (( now > exp_time )) && exp_txt="${exp_txt} ${rojo}(EXPIRADO)${reset}"
    else
        exp_time=""; exp_txt="${amarillo}SIN EXPIRACION${reset}"
    fi

    echo
    echo -e "${negrita}Editando IP:${reset} ${ip}"
    echo "  Nombre: ${nom:--}"
    echo -e "  Expira: ${exp_txt}"
    echo
    echo " 1) Cambiar días (se cuentan desde hoy)"
    echo " 2) Renovar / sumar días (se suman a la fecha actual de vencimiento)"
    echo " 3) Cambiar nombre"
    echo " 0) Cancelar"
    read -rp "Opción: " eop

    case $eop in
        1|2)
            read -rp "Días: " dias
            [[ $dias =~ ^[0-9]+$ && $dias -gt 0 ]] || { echo -e "${rojo}Días inválidos (número mayor a 0).${reset}"; return; }
            local base=$now
            # Al sumar: si todavía no venció, se suma a su vencimiento; si ya venció o no tenía, desde hoy
            if [[ $eop == 2 && -n $exp_time ]] && (( exp_time > now )); then base=$exp_time; fi
            local new_exp=$(( base + (dias * 86400) ))
            if [[ -z $nom ]]; then
                read -rp "Esta IP no tiene nombre. Nombre: " nom
                nom=$(echo "$nom" | tr -d ":'|\"" | sed 's/^ *//;s/ *$//')
                [[ -n $nom ]] || nom="sin-nombre"
            fi
            guardar_ip_data "$nom" "$ip" "$new_exp"
            echo -e "${verde}Fecha de expiración actualizada! ${nom} -> ${ip} vence el $(date -d "@$new_exp" '+%d/%m/%Y %H:%M').${reset}"
            ;;
        3)
            read -rp "Nuevo nombre: " nuevo
            nuevo=$(echo "$nuevo" | tr -d ":'|\"" | sed 's/^ *//;s/ *$//')
            [[ -n $nuevo ]] || { echo -e "${rojo}El nombre no puede estar vacío.${reset}"; return; }
            if [[ -n $exp_time ]]; then
                guardar_ip_data "$nuevo" "$ip" "$exp_time"
                echo -e "${verde}Nombre actualizado: ${nuevo} -> ${ip}${reset}"
            else
                echo -e "${amarillo}Esta IP no tiene vencimiento. Primero asignale días con la opción 1.${reset}"
            fi
            ;;
        *) echo "Cancelado."; return ;;
    esac
    echo; ver_ips
}

menu_ver_ips() {
    ver_ips
    echo
    echo " 1) ELIMINAR EXPIRADOS"
    echo " 2) EDITAR IP EXISTENTE"
    echo " 3) ELIMINAR UNA IP"
    echo " 0) Volver"
    read -rp "Opción: " vop
    if [[ $vop == 3 ]]; then
        echo; eliminar_ip --sin-lista; echo; ver_ips
    elif [[ $vop == 2 ]]; then
        echo; editar_ip
    elif [[ $vop == 1 ]]; then
        echo
        read -rp "¿Eliminar del panel y del firewall todas las IPs expiradas? [s/n]: " ok
        if [[ ${ok,,} == s* ]]; then
            echo
            check_and_clean_expired
            echo; ver_ips
        else
            echo "Cancelado."
        fi
    fi
}

eliminar_ip() {
    # Con --sin-lista no vuelve a mostrar la lista (se usa desde la opción 2)
    [[ $1 == --sin-lista ]] || { ver_ips; echo; }
    buscar_ip "ID, NOMBRE O IP A ELIMINAR: " || return
    local ip_del=$IP_SEL nom
    nom=$(awk -F: -v ip="$ip_del" '$2 == ip {print $1}' "$IPS_DATA" 2>/dev/null | tail -1)
    read -rp "¿Eliminar ${nom:+${nom} -> }${ip_del} del panel y del firewall? [s/n]: " ok
    [[ ${ok,,} == s* ]] || { echo "Cancelado."; return; }

    sqlite3 "$DB" "DELETE FROM IPADDRS WHERE ipaddr='${ip_del}';"
    while iptables -t nat -D PREROUTING -s "${ip_del}/32" -i eth0 -j ACCEPT 2>/dev/null; do :; done
    while iptables -D INPUT -s "${ip_del}/32" -p tcp --dport 53 -j ACCEPT 2>/dev/null; do :; done
    if [[ -f $IPS_DATA ]]; then
        awk -F: -v ip="$ip_del" '$2 != ip' "$IPS_DATA" > "${IPS_DATA}.tmp" && mv "${IPS_DATA}.tmp" "$IPS_DATA"
    fi
    netfilter-persistent save >/dev/null 2>&1
    echo -e "${verde}IP ${nom:+${nom} -> }${ip_del} eliminada (panel + firewall).${reset}"
}

limpiar_duplicados() {
    sqlite3 "$DB" "DELETE FROM IPADDRS WHERE ID NOT IN (SELECT MIN(ID) FROM IPADDRS GROUP BY ipaddr);"
    echo -e "${verde}Duplicados eliminados.${reset}"; ver_ips
}

agregar_dominio() {
    read -rp "Dominio a pasar por el proxy (ej: ejemplo.com): " dom
    dom=$(echo "$dom" | tr -d ' ' | tr 'A-Z' 'a-z')
    [[ "$dom" =~ ^[a-z0-9.-]+\.[a-z]{2,}$ ]] || { echo -e "${rojo}Dominio no válido.${reset}"; return; }
    grep -q "^address=/${dom}/" "$DIR/dnsmasq.conf" || echo "address=/${dom}/${IP}" >> "$DIR/dnsmasq.conf"
    grep -qx "$dom" "$DIR/proxy-domains.txt" || echo "$dom" >> "$DIR/proxy-domains.txt"
    echo "+ docker restart dnsmasq"; docker restart dnsmasq
    sleep 2
    echo "+ dig +short ${dom} @${IP}"; dig +short "$dom" @"$IP"
    if [[ "$(dig +short "$dom" @"$IP" | head -1)" == "$IP" ]]; then
        echo -e "${verde}${dom} ahora pasa por el proxy.${reset}"
    else
        echo -e "${amarillo}Se agregó, pero dig no responde ${IP}. Revisá dnsmasq.conf.${reset}"
    fi
}

comprobar_dominio() {
    read -rp "Dominio a comprobar (ej: speedtest.net): " dom
    dom=$(echo "$dom" | tr -d ' ')
    [[ -n "$dom" ]] || return
    echo "+ dig +short ${dom} @${IP}"
    res=$(dig +short "$dom" @"$IP")
    echo "$res"
    if echo "$res" | grep -qx "$IP"; then
        echo -e "${verde}${dom} pasa por el proxy.${reset}"
    else
        echo -e "${amarillo}${dom} NO pasa por el proxy (responde su IP real).${reset}"
    fi
}

reiniciar_dnsmasq() {
    echo "+ docker restart dnsmasq"; docker restart dnsmasq
    echo -e "${verde}dnsmasq reiniciado.${reset}"
}

ver_dominios() {
    echo -e "${negrita}Dominios que pasan por el proxy:${reset}"
    grep -o '^address=/[^/]*/' "$DIR/dnsmasq.conf" | cut -d/ -f2 | sort -u | (column 2>/dev/null || cat)
}

eliminar_dominio() {
    read -rp "INGRESE DOMINIO: " dom
    dom=$(echo "$dom" | tr -d ' ' | tr 'A-Z' 'a-z')
    [[ -n $dom ]] || { echo "Cancelado."; return; }
    [[ "$dom" =~ ^[a-z0-9.-]+\.[a-z]{2,}$ ]] || { echo -e "${rojo}Dominio no válido.${reset}"; return; }

    # Buscar el dominio exacto en las líneas address=/dom1/dom2/.../IP
    if ! awk -F/ -v d="$dom" '/^address=\// {for (i = 2; i < NF; i++) if ($i == d) f = 1} END {exit !f}' "$DIR/dnsmasq.conf"; then
        echo -e "${rojo}${dom} no está en la lista de dominios del proxy.${reset}"
        return
    fi

    read -rp "¿Eliminar ${dom} del proxy? [s/n]: " ok
    [[ ${ok,,} == s* ]] || { echo "Cancelado."; return; }

    cp "$DIR/dnsmasq.conf" "$DIR/dnsmasq.conf.bak"
    # Quita el dominio; si la línea se queda sin dominios, se borra entera
    awk -F/ -v d="$dom" '
    /^address=\// {
        out = "address="; n = 0
        for (i = 2; i < NF; i++) if ($i != d && $i != "") { out = out "/" $i; n++ }
        if (n > 0) print out "/" $NF
        next
    }
    { print }' "$DIR/dnsmasq.conf.bak" > "$DIR/dnsmasq.conf"

    if [[ -f $DIR/proxy-domains.txt ]]; then
        grep -vxF "$dom" "$DIR/proxy-domains.txt" > "$DIR/proxy-domains.txt.tmp"
        mv "$DIR/proxy-domains.txt.tmp" "$DIR/proxy-domains.txt"
    fi

    echo "+ docker restart dnsmasq"; docker restart dnsmasq
    sleep 2
    echo "+ dig +short ${dom} @${IP}"; dig +short "$dom" @"$IP"
    if dig +short "$dom" @"$IP" | grep -qx "$IP"; then
        # Puede seguir pasando si hay un dominio padre en la lista (ej: flow.com.ar cubre api.flow.com.ar)
        local padre
        padre=$(grep -o '^address=/[^/]*/' "$DIR/dnsmasq.conf" | cut -d/ -f2 | while read -r d; do
            [[ $dom == *".$d" ]] && echo "$d"; done | head -1)
        if [[ -n $padre ]]; then
            echo -e "${amarillo}${dom} se eliminó, pero sigue pasando por el proxy porque está ${padre}, que cubre sus subdominios.${reset}"
        else
            echo -e "${amarillo}${dom} se eliminó, pero dig todavía responde ${IP}. Probá reiniciar dnsmasq (opción 8).${reset}"
        fi
    else
        echo -e "${verde}${dom} eliminado: ya no pasa por el proxy.${reset}"
    fi
    echo "  (copia anterior en $DIR/dnsmasq.conf.bak)"
}

menu_ver_dominios() {
    ver_dominios
    echo
    echo " 1) ELIMINAR UN DOMINIO"
    echo
    read -rp "Opción (Enter para volver): " dop
    if [[ $dop == 1 ]]; then
        echo; eliminar_dominio
    else
        return 1   # para no pedir Enter dos veces
    fi
}

cambiar_pass() {
    read -rp "Nueva contraseña admin (6 a 8 letras o números): " np
    [[ "$np" =~ ^[A-Za-z0-9]{6,8}$ ]] || { echo -e "${rojo}Contraseña no válida.${reset}"; return; }
    hash=$(cd "$DIR/auth" && "$DIR/venv/bin/python" pbkdf2_sha256_hash.py "$np" | awk '{print $2}')
    [[ "$hash" == \$pbkdf2-sha256\$* ]] || { echo -e "${rojo}No se pudo generar el hash.${reset}"; return; }
    sqlite3 "$DB" "UPDATE users SET password='${hash}', expires='2099-12-31' WHERE username='admin';"
    sed -i "s/^ADMIN_PASS=.*/ADMIN_PASS=${np}/" "$CONF"
    ADMIN_PASS=$np
    systemctl restart netflix-proxy-admin
    echo -e "${verde}Contraseña cambiada a: ${np}${reset}"
}

estado() {
    echo -e "${negrita}Contenedores:${reset}"
    docker ps -a --format 'table {{.Names}}\t{{.Status}}' | grep -E 'NAMES|dnsmasq|sniproxy|caddy'
    echo
    systemctl is-active --quiet netflix-proxy-admin \
        && echo -e " ${verde}●${reset} panel admin activo" || echo -e " ${rojo}●${reset} panel admin detenido"
}

reiniciar() {
    docker restart $(docker ps -a --format '{{.Names}}' | grep -E 'dnsmasq|sniproxy|caddy') >/dev/null 2>&1
    systemctl restart netflix-proxy-admin
    echo -e "${verde}Servicios reiniciados.${reset}"; echo; estado
}

comandos_tunel() {
    echo -e "${negrita}Ejecutá esto en el VPS del túnel (SSH/V2Ray):${reset}"
    echo
    echo "iptables -t nat -A OUTPUT -p udp --dport 53 -j DNAT --to-destination ${IP}:53"
    echo "iptables -t nat -A OUTPUT -p tcp --dport 53 -j DNAT --to-destination ${IP}:53"
    echo "apt-get -y install iptables-persistent"
    echo "netfilter-persistent save"
    echo
    echo -e "${amarillo}Antes, autorizá la IP de ese VPS con la opción 1.${reset}"
    echo "En la app VPN: DNS 8.8.8.8 / 8.8.4.4 con DNS Forwarding marcado."
}

# ======================== BACKUP / RESTORE ========================
# Los backups se guardan fuera de $DIR para que sobrevivan a una reinstalación.
BACKUP_DIR=/root/netflix-proxy-backups

# IPs autorizadas en el firewall (nat PREROUTING + INPUT tcp/53), una por línea
ips_firewall() {
    {
        iptables -t nat -S PREROUTING 2>/dev/null | grep -E -- '-i eth0 -j ACCEPT$'
        iptables -S INPUT 2>/dev/null | grep -E -- '-p tcp .*--dport 53 -j ACCEPT$'
    } | grep -oE -- '-s [0-9.]+/32' | awk '{sub("/32","",$2); print $2}' | sort -u
}

# Aplica las dos reglas de la opción 1 a una IP (sin duplicar)
aplicar_reglas_ip() {
    local ip=$1
    iptables -t nat -C PREROUTING -s "${ip}/32" -i eth0 -j ACCEPT 2>/dev/null \
        || iptables -t nat -I PREROUTING -s "${ip}/32" -i eth0 -j ACCEPT
    iptables -C INPUT -s "${ip}/32" -p tcp --dport 53 -j ACCEPT 2>/dev/null \
        || iptables -I INPUT -s "${ip}/32" -p tcp --dport 53 -j ACCEPT
}

quitar_reglas_ip() {
    local ip=$1
    while iptables -t nat -D PREROUTING -s "${ip}/32" -i eth0 -j ACCEPT 2>/dev/null; do :; done
    while iptables -D INPUT -s "${ip}/32" -p tcp --dport 53 -j ACCEPT 2>/dev/null; do :; done
}

listar_backups() {
    mapfile -t BACKUPS < <(ls -1t "$BACKUP_DIR"/np_backup_*.tar.gz 2>/dev/null)
    if [[ ${#BACKUPS[@]} -eq 0 ]]; then
        echo -e "${amarillo}No hay backups en ${BACKUP_DIR}.${reset}"
        return 1
    fi
    echo -e "${negrita}Backups (más reciente primero):${reset}"
    local i=1
    for b in "${BACKUPS[@]}"; do
        echo "  $i) $(basename "$b")  ($(du -h "$b" | cut -f1))"
        i=$((i + 1))
    done
}

crear_backup() {
    [[ -f $DB ]] || { echo -e "${rojo}No se encontró ${DB}.${reset}"; return 1; }
    mkdir -p "$BACKUP_DIR"; chmod 700 "$BACKUP_DIR"
    local ts tmp file
    ts=$(date +%Y%m%d_%H%M%S)
    tmp=$(mktemp -d)
    file="$BACKUP_DIR/np_backup_${ts}.tar.gz"

    # Copia consistente de la base aunque el panel esté escribiendo
    sqlite3 "$DB" ".backup '${tmp}/auth.db'" || { echo -e "${rojo}Falló la copia de auth.db.${reset}"; rm -rf "$tmp"; return 1; }
    ips_firewall > "$tmp/ips_firewall.txt"
    if [[ -f $IPS_DATA ]]; then cp "$IPS_DATA" "$tmp/ips_expira.txt"; else : > "$tmp/ips_expira.txt"; fi
    cat > "$tmp/info.txt" <<INFO
FECHA=${ts}
IP_ORIGEN=${IP}
ADMIN_PASS=${ADMIN_PASS}
INFO

    tar -czf "$file" -C "$tmp" auth.db ips_firewall.txt info.txt ips_expira.txt
    rm -rf "$tmp"; chmod 600 "$file"

    echo -e "${verde}Backup creado:${reset} $file"
    echo "  IPs en la base: $(sqlite3 "$DB" 'SELECT COUNT(*) FROM IPADDRS;')"
    echo "  IPs en el firewall: $(ips_firewall | wc -l)"
    echo
    echo -e "${negrita}Para descargarlo a tu PC, ejecutá en tu PC:${reset}"
    echo "  scp root@${IP}:${file} ."
}

restaurar_backup() {
    local sel
    echo " Elegí un backup de la lista, o escribí la ruta de un .tar.gz"
    echo " (por ejemplo, uno que subiste desde otro VPS)."
    echo
    listar_backups
    echo "  0) Cancelar"
    echo
    read -rp "Número o ruta: " sel
    [[ -z $sel || $sel == 0 ]] && { echo "Cancelado."; return; }
    if [[ $sel =~ ^[0-9]+$ ]]; then
        [[ $sel -le ${#BACKUPS[@]} ]] || { echo -e "${rojo}Opción no válida.${reset}"; return; }
        sel=${BACKUPS[$((sel - 1))]}
    fi
    [[ -f $sel ]] || { echo -e "${rojo}No existe: ${sel}${reset}"; return; }

    local tmp; tmp=$(mktemp -d)
    tar -xzf "$sel" -C "$tmp" ips_expira.txt 2>/dev/null   # no existe en backups viejos
    if ! tar -xzf "$sel" -C "$tmp" auth.db ips_firewall.txt info.txt 2>/dev/null; then
        echo -e "${rojo}El archivo no es un backup válido de menu2.${reset}"; rm -rf "$tmp"; return
    fi
    if ! sqlite3 "$tmp/auth.db" "SELECT COUNT(*) FROM IPADDRS;" >/dev/null 2>&1; then
        echo -e "${rojo}auth.db del backup está dañada.${reset}"; rm -rf "$tmp"; return
    fi

    echo
    echo -e "${negrita}Contenido del backup:${reset}"
    grep -E '^(FECHA|IP_ORIGEN)=' "$tmp/info.txt" | sed 's/^/  /'
    sqlite3 -header -column "$tmp/auth.db" "SELECT ID, created, ipaddr FROM IPADDRS ORDER BY ID;"
    echo
    echo -e "${amarillo}Se reemplazarán la base del panel y las IPs autorizadas del firewall.${reset}"
    read -rp "¿Confirmás la restauración? [s/n]: " ok
    [[ ${ok,,} == s* ]] || { echo "Cancelado."; rm -rf "$tmp"; return; }

    # Backup automático del estado actual por si hay que volver atrás
    echo "+ Guardando el estado actual antes de restaurar..."
    crear_backup >/dev/null && echo "  (guardado en ${BACKUP_DIR})"

    # 1) Base de datos
    local owner; owner=$(stat -c '%U:%G' "$DB" 2>/dev/null || echo root:root)
    systemctl stop netflix-proxy-admin
    rm -f "${DB}-wal" "${DB}-shm" "${DB}-journal"
    cp "$tmp/auth.db" "$DB"
    chown "$owner" "$DB"

    # Contraseña admin: la base trae el hash del backup, así que se usa su contraseña
    local bpass; bpass=$(grep '^ADMIN_PASS=' "$tmp/info.txt" | cut -d= -f2)
    if [[ $bpass =~ ^[A-Za-z0-9]+$ ]]; then
        sed -i "s/^ADMIN_PASS=.*/ADMIN_PASS=${bpass}/" "$CONF"
        ADMIN_PASS=$bpass
    fi
    systemctl start netflix-proxy-admin

    # 2) Firewall: quitar las IPs actuales y poner las del backup + las de la base
    local ip
    for ip in $(ips_firewall); do quitar_reglas_ip "$ip"; done
    for ip in $( { cat "$tmp/ips_firewall.txt"; sqlite3 "$DB" "SELECT ipaddr FROM IPADDRS;"; } | sort -u); do
        valid_ip "$ip" && aplicar_reglas_ip "$ip"
    done
    netfilter-persistent save >/dev/null 2>&1
    if [[ -f $tmp/ips_expira.txt ]]; then
        cp "$tmp/ips_expira.txt" "$IPS_DATA"
    fi
    rm -rf "$tmp"

    echo -e "${verde}Backup restaurado.${reset}"
    echo "  Contraseña admin: ${ADMIN_PASS}"
    echo "  IPs en el firewall: $(ips_firewall | wc -l)"
    echo; ver_ips
}

eliminar_backup() {
    listar_backups || return
    echo "  a) Eliminar TODOS"
    echo "  0) Cancelar"
    echo
    read -rp "¿Cuál eliminar?: " sel
    if [[ ${sel,,} == a ]]; then
        read -rp "¿Eliminar los ${#BACKUPS[@]} backups? [s/n]: " ok
        [[ ${ok,,} == s* ]] && rm -f "$BACKUP_DIR"/np_backup_*.tar.gz && echo -e "${verde}Backups eliminados.${reset}"
        return
    fi
    [[ $sel =~ ^[0-9]+$ && $sel -ge 1 && $sel -le ${#BACKUPS[@]} ]] || { echo "Cancelado."; return; }
    rm -f "${BACKUPS[$((sel - 1))]}"
    echo -e "${verde}Eliminado: $(basename "${BACKUPS[$((sel - 1))]}")${reset}"
}

menu_backup() {
    while true; do
        clear
        echo -e "${negrita}============ BACKUP ============${reset}"
        echo " Carpeta: ${BACKUP_DIR}"
        echo "---------------------------------"
        echo " 1) Crear backup (y ver cómo descargarlo)"
        echo " 2) Restaurar backup"
        echo " 3) Ver backups"
        echo " 4) Eliminar backup"
        echo " 0) Volver"
        echo "---------------------------------"
        read -rp "Opción: " bop
        echo
        case $bop in
            1) crear_backup ;;
            2) restaurar_backup ;;
            3) listar_backups ;;
            4) eliminar_backup ;;
            0) return ;;
            *) echo "Opción no válida." ;;
        esac
        pausa
    done
}

