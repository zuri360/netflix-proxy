#!/usr/bin/env bash
# Menú de gestión de netflix-proxy — se abre escribiendo: menu2

CONF=/etc/netflix-proxy-menu.conf
DIR=/root/netflix-proxy
DB=$DIR/auth/db/auth.db

verde='\e[32m'; rojo='\e[31m'; amarillo='\e[33m'; negrita='\e[1m'; reset='\e[0m'

[[ $EUID -eq 0 ]] || { echo "Ejecutá menu2 como root."; exit 1; }
[[ -f $CONF ]] || { echo "Falta $CONF. Reinstalá con install.sh."; exit 1; }
. "$CONF"   # define IP y ADMIN_PASS

valid_ip() { [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; }
pausa()    { echo; read -rp "Enter para volver al menú..." _; }

agregar_ip() {
    read -rp "IP a autorizar: " nueva
    nueva=$(echo "$nueva" | tr -d ' ')
    valid_ip "$nueva" || { echo -e "${rojo}IP no válida.${reset}"; return; }
    curl -s -o /dev/null "http://${IP}:8080/autoadd?ip=${nueva}&username=admin&password=${ADMIN_PASS}"
    # El panel a veces no aplica la regla en el firewall: se asegura acá
    if ! iptables -t nat -C PREROUTING -s "${nueva}/32" -i eth0 -j ACCEPT 2>/dev/null; then
        iptables -t nat -I PREROUTING -s "${nueva}/32" -i eth0 -j ACCEPT
    fi
    # DNS por TCP (necesario cuando la IP es un VPS de túnel con DNS Forwarding)
    if ! iptables -C INPUT -s "${nueva}/32" -p tcp --dport 53 -j ACCEPT 2>/dev/null; then
        iptables -I INPUT -s "${nueva}/32" -p tcp --dport 53 -j ACCEPT
    fi
    netfilter-persistent save >/dev/null 2>&1
    if sqlite3 "$DB" "SELECT 1 FROM IPADDRS WHERE ipaddr='${nueva}' LIMIT 1;" | grep -q 1; then
        echo -e "${verde}IP ${nueva} autorizada (panel + firewall + DNS TCP).${reset}"
    else
        echo -e "${amarillo}Firewall OK, pero el panel no la registró. Revisá la contraseña en ${CONF}.${reset}"
    fi
}

ver_ips() {
    echo -e "${negrita}IPs autorizadas:${reset}"
    sqlite3 -header -column "$DB" "SELECT ID, created, ipaddr FROM IPADDRS ORDER BY ID;"
}

eliminar_ip() {
    ver_ips; echo
    read -rp "IP a eliminar: " ip_del
    ip_del=$(echo "$ip_del" | tr -d ' ')
    valid_ip "$ip_del" || { echo -e "${rojo}IP no válida.${reset}"; return; }
    sqlite3 "$DB" "DELETE FROM IPADDRS WHERE ipaddr='${ip_del}';"
    while iptables -t nat -D PREROUTING -s "${ip_del}/32" -i eth0 -j ACCEPT 2>/dev/null; do :; done
    while iptables -D INPUT -s "${ip_del}/32" -p tcp --dport 53 -j ACCEPT 2>/dev/null; do :; done
    netfilter-persistent save >/dev/null 2>&1
    echo -e "${verde}IP ${ip_del} eliminada (panel + firewall).${reset}"
}

limpiar_duplicados() {
    sqlite3 "$DB" "DELETE FROM IPADDRS WHERE ID NOT IN (SELECT MIN(ID) FROM IPADDRS GROUP BY ipaddr);"
    echo -e "${verde}Duplicados eliminados.${reset}"; ver_ips
}

agregar_dominio() {
    read -rp "Dominio a pasar por el proxy (ej: ejemplo.com): " dom
    dom=$(echo "$dom" | tr -d ' ' | tr 'A-Z' 'a-z')
    [[ "$dom" =~ ^[a-z0-9.-]+\.[a-z]{2,}$ ]] || { echo -e "${rojo}Dominio no válido.${reset}"; return; }
    grep -q "^address=/${dom}/" "$DIR/dnsmasq.conf" || echo "address=/${dom}/${IP}" >> "$DIR/dnsmasq.conf"
    grep -qx "$dom" "$DIR/proxy-domains.txt" || echo "$dom" >> "$DIR/proxy-domains.txt"
    echo "+ docker restart dnsmasq"; docker restart dnsmasq
    sleep 2
    echo "+ dig +short ${dom} @${IP}"; dig +short "$dom" @"$IP"
    if [[ "$(dig +short "$dom" @"$IP" | head -1)" == "$IP" ]]; then
        echo -e "${verde}${dom} ahora pasa por el proxy.${reset}"
    else
        echo -e "${amarillo}Se agregó, pero dig no responde ${IP}. Revisá dnsmasq.conf.${reset}"
    fi
}

comprobar_dominio() {
    read -rp "Dominio a comprobar (ej: speedtest.net): " dom
    dom=$(echo "$dom" | tr -d ' ')
    [[ -n "$dom" ]] || return
    echo "+ dig +short ${dom} @${IP}"
    res=$(dig +short "$dom" @"$IP")
    echo "$res"
    if echo "$res" | grep -qx "$IP"; then
        echo -e "${verde}${dom} pasa por el proxy.${reset}"
    else
        echo -e "${amarillo}${dom} NO pasa por el proxy (responde su IP real).${reset}"
    fi
}

reiniciar_dnsmasq() {
    echo "+ docker restart dnsmasq"; docker restart dnsmasq
    echo -e "${verde}dnsmasq reiniciado.${reset}"
}

ver_dominios() {
    echo -e "${negrita}Dominios que pasan por el proxy:${reset}"
    grep -o '^address=/[^/]*/' "$DIR/dnsmasq.conf" | cut -d/ -f2 | sort -u | (column 2>/dev/null || cat)
}

cambiar_pass() {
    read -rp "Nueva contraseña admin (6 a 8 letras o números): " np
    [[ "$np" =~ ^[A-Za-z0-9]{6,8}$ ]] || { echo -e "${rojo}Contraseña no válida.${reset}"; return; }
    hash=$(cd "$DIR/auth" && "$DIR/venv/bin/python" pbkdf2_sha256_hash.py "$np" | awk '{print $2}')
    [[ "$hash" == \$pbkdf2-sha256\$* ]] || { echo -e "${rojo}No se pudo generar el hash.${reset}"; return; }
    sqlite3 "$DB" "UPDATE users SET password='${hash}', expires='2099-12-31' WHERE username='admin';"
    sed -i "s/^ADMIN_PASS=.*/ADMIN_PASS=${np}/" "$CONF"
    ADMIN_PASS=$np
    systemctl restart netflix-proxy-admin
    echo -e "${verde}Contraseña cambiada a: ${np}${reset}"
}

estado() {
    echo -e "${negrita}Contenedores:${reset}"
    docker ps -a --format 'table {{.Names}}\t{{.Status}}' | grep -E 'NAMES|dnsmasq|sniproxy|caddy'
    echo
    systemctl is-active --quiet netflix-proxy-admin \
        && echo -e " ${verde}●${reset} panel admin activo" || echo -e " ${rojo}●${reset} panel admin detenido"
}

reiniciar() {
    docker restart $(docker ps -a --format '{{.Names}}' | grep -E 'dnsmasq|sniproxy|caddy') >/dev/null 2>&1
    systemctl restart netflix-proxy-admin
    echo -e "${verde}Servicios reiniciados.${reset}"; echo; estado
}

comandos_tunel() {
    echo -e "${negrita}Ejecutá esto en el VPS del túnel (SSH/V2Ray):${reset}"
    echo
    echo "iptables -t nat -A OUTPUT -p udp --dport 53 -j DNAT --to-destination ${IP}:53"
    echo "iptables -t nat -A OUTPUT -p tcp --dport 53 -j DNAT --to-destination ${IP}:53"
    echo "apt-get -y install iptables-persistent"
    echo "netfilter-persistent save"
    echo
    echo -e "${amarillo}Antes, autorizá la IP de ese VPS con la opción 1.${reset}"
    echo "En la app VPN: DNS 8.8.8.8 / 8.8.4.4 con DNS Forwarding marcado."
}

# ======================== BACKUP / RESTORE ========================
# Los backups se guardan fuera de $DIR para que sobrevivan a una reinstalación.
BACKUP_DIR=/root/netflix-proxy-backups

# IPs autorizadas en el firewall (nat PREROUTING + INPUT tcp/53), una por línea
ips_firewall() {
    {
        iptables -t nat -S PREROUTING 2>/dev/null | grep -E -- '-i eth0 -j ACCEPT$'
        iptables -S INPUT 2>/dev/null | grep -E -- '-p tcp .*--dport 53 -j ACCEPT$'
    } | grep -oE -- '-s [0-9.]+/32' | awk '{sub("/32","",$2); print $2}' | sort -u
}

# Aplica las dos reglas de la opción 1 a una IP (sin duplicar)
aplicar_reglas_ip() {
    local ip=$1
    iptables -t nat -C PREROUTING -s "${ip}/32" -i eth0 -j ACCEPT 2>/dev/null \
        || iptables -t nat -I PREROUTING -s "${ip}/32" -i eth0 -j ACCEPT
    iptables -C INPUT -s "${ip}/32" -p tcp --dport 53 -j ACCEPT 2>/dev/null \
        || iptables -I INPUT -s "${ip}/32" -p tcp --dport 53 -j ACCEPT
}

quitar_reglas_ip() {
    local ip=$1
    while iptables -t nat -D PREROUTING -s "${ip}/32" -i eth0 -j ACCEPT 2>/dev/null; do :; done
    while iptables -D INPUT -s "${ip}/32" -p tcp --dport 53 -j ACCEPT 2>/dev/null; do :; done
}

listar_backups() {
    mapfile -t BACKUPS < <(ls -1t "$BACKUP_DIR"/np_backup_*.tar.gz 2>/dev/null)
    if [[ ${#BACKUPS[@]} -eq 0 ]]; then
        echo -e "${amarillo}No hay backups en ${BACKUP_DIR}.${reset}"
        return 1
    fi
    echo -e "${negrita}Backups (más reciente primero):${reset}"
    local i=1
    for b in "${BACKUPS[@]}"; do
        echo "  $i) $(basename "$b")  ($(du -h "$b" | cut -f1))"
        i=$((i + 1))
    done
}

crear_backup() {
    [[ -f $DB ]] || { echo -e "${rojo}No se encontró ${DB}.${reset}"; return 1; }
    mkdir -p "$BACKUP_DIR"; chmod 700 "$BACKUP_DIR"
    local ts tmp file
    ts=$(date +%Y%m%d_%H%M%S)
    tmp=$(mktemp -d)
    file="$BACKUP_DIR/np_backup_${ts}.tar.gz"

    # Copia consistente de la base aunque el panel esté escribiendo
    sqlite3 "$DB" ".backup '${tmp}/auth.db'" || { echo -e "${rojo}Falló la copia de auth.db.${reset}"; rm -rf "$tmp"; return 1; }
    ips_firewall > "$tmp/ips_firewall.txt"
    cat > "$tmp/info.txt" <<INFO
FECHA=${ts}
IP_ORIGEN=${IP}
ADMIN_PASS=${ADMIN_PASS}
INFO

    tar -czf "$file" -C "$tmp" auth.db ips_firewall.txt info.txt
    rm -rf "$tmp"; chmod 600 "$file"

    echo -e "${verde}Backup creado:${reset} $file"
    echo "  IPs en la base: $(sqlite3 "$DB" 'SELECT COUNT(*) FROM IPADDRS;')"
    echo "  IPs en el firewall: $(ips_firewall | wc -l)"
    echo
    echo -e "${negrita}Para descargarlo a tu PC, ejecutá en tu PC:${reset}"
    echo "  scp root@${IP}:${file} ."
}

restaurar_backup() {
    local sel
    echo " Elegí un backup de la lista, o escribí la ruta de un .tar.gz"
    echo " (por ejemplo, uno que subiste desde otro VPS)."
    echo
    listar_backups
    echo "  0) Cancelar"
    echo
    read -rp "Número o ruta: " sel
    [[ -z $sel || $sel == 0 ]] && { echo "Cancelado."; return; }
    if [[ $sel =~ ^[0-9]+$ ]]; then
        [[ $sel -le ${#BACKUPS[@]} ]] || { echo -e "${rojo}Opción no válida.${reset}"; return; }
        sel=${BACKUPS[$((sel - 1))]}
    fi
    [[ -f $sel ]] || { echo -e "${rojo}No existe: ${sel}${reset}"; return; }

    local tmp; tmp=$(mktemp -d)
    if ! tar -xzf "$sel" -C "$tmp" auth.db ips_firewall.txt info.txt 2>/dev/null; then
        echo -e "${rojo}El archivo no es un backup válido de menu2.${reset}"; rm -rf "$tmp"; return
    fi
    if ! sqlite3 "$tmp/auth.db" "SELECT COUNT(*) FROM IPADDRS;" >/dev/null 2>&1; then
        echo -e "${rojo}auth.db del backup está dañada.${reset}"; rm -rf "$tmp"; return
    fi

    echo
    echo -e "${negrita}Contenido del backup:${reset}"
    grep -E '^(FECHA|IP_ORIGEN)=' "$tmp/info.txt" | sed 's/^/  /'
    sqlite3 -header -column "$tmp/auth.db" "SELECT ID, created, ipaddr FROM IPADDRS ORDER BY ID;"
    echo
    echo -e "${amarillo}Se reemplazarán la base del panel y las IPs autorizadas del firewall.${reset}"
    read -rp "¿Confirmás la restauración? [s/n]: " ok
    [[ ${ok,,} == s* ]] || { echo "Cancelado."; rm -rf "$tmp"; return; }

    # Backup automático del estado actual por si hay que volver atrás
    echo "+ Guardando el estado actual antes de restaurar..."
    crear_backup >/dev/null && echo "  (guardado en ${BACKUP_DIR})"

    # 1) Base de datos
    local owner; owner=$(stat -c '%U:%G' "$DB" 2>/dev/null || echo root:root)
    systemctl stop netflix-proxy-admin
    rm -f "${DB}-wal" "${DB}-shm" "${DB}-journal"
    cp "$tmp/auth.db" "$DB"
    chown "$owner" "$DB"

    # Contraseña admin: la base trae el hash del backup, así que se usa su contraseña
    local bpass; bpass=$(grep '^ADMIN_PASS=' "$tmp/info.txt" | cut -d= -f2)
    if [[ $bpass =~ ^[A-Za-z0-9]+$ ]]; then
        sed -i "s/^ADMIN_PASS=.*/ADMIN_PASS=${bpass}/" "$CONF"
        ADMIN_PASS=$bpass
    fi
    systemctl start netflix-proxy-admin

    # 2) Firewall: quitar las IPs actuales y poner las del backup + las de la base
    local ip
    for ip in $(ips_firewall); do quitar_reglas_ip "$ip"; done
    for ip in $( { cat "$tmp/ips_firewall.txt"; sqlite3 "$DB" "SELECT ipaddr FROM IPADDRS;"; } | sort -u); do
        valid_ip "$ip" && aplicar_reglas_ip "$ip"
    done
    netfilter-persistent save >/dev/null 2>&1
    rm -rf "$tmp"

    echo -e "${verde}Backup restaurado.${reset}"
    echo "  Contraseña admin: ${ADMIN_PASS}"
    echo "  IPs en el firewall: $(ips_firewall | wc -l)"
    echo; ver_ips
}

eliminar_backup() {
    listar_backups || return
    echo "  a) Eliminar TODOS"
    echo "  0) Cancelar"
    echo
    read -rp "¿Cuál eliminar?: " sel
    if [[ ${sel,,} == a ]]; then
        read -rp "¿Eliminar los ${#BACKUPS[@]} backups? [s/n]: " ok
        [[ ${ok,,} == s* ]] && rm -f "$BACKUP_DIR"/np_backup_*.tar.gz && echo -e "${verde}Backups eliminados.${reset}"
        return
    fi
    [[ $sel =~ ^[0-9]+$ && $sel -ge 1 && $sel -le ${#BACKUPS[@]} ]] || { echo "Cancelado."; return; }
    rm -f "${BACKUPS[$((sel - 1))]}"
    echo -e "${verde}Eliminado: $(basename "${BACKUPS[$((sel - 1))]}")${reset}"
}

menu_backup() {
    while true; do
        clear
        echo -e "${negrita}============ BACKUP ============${reset}"
        echo " Carpeta: ${BACKUP_DIR}"
        echo "---------------------------------"
        echo " 1) Crear backup (y ver cómo descargarlo)"
        echo " 2) Restaurar backup"
        echo " 3) Ver backups"
        echo " 4) Eliminar backup"
        echo " 0) Volver"
        echo "---------------------------------"
        read -rp "Opción: " bop
        echo
        case $bop in
            1) crear_backup ;;
            2) restaurar_backup ;;
            3) listar_backups ;;
            4) eliminar_backup ;;
            0) return ;;
            *) echo "Opción no válida." ;;
        esac
        pausa
    done
}

while true; do
    clear
    echo -e "${negrita}========= NETFLIX-PROXY =========${reset}"
    echo -e " Panel: http://${IP}:8080/   DNS: ${IP}"
    echo -e " Admin: admin / ${ADMIN_PASS}"
    echo "---------------------------------"
    echo " 1) Agregar IP"
    echo " 2) Ver IPs autorizadas"
    echo " 3) Eliminar IP"
    echo " 4) Limpiar IPs duplicadas"
    echo " 5) Agregar dominio al proxy"
    echo " 6) Comprobar dominio (dig)"
    echo " 7) Ver dominios del proxy"
    echo " 8) Reiniciar dnsmasq"
    echo " 9) Cambiar contraseña admin"
    echo "10) Estado de servicios"
    echo "11) Reiniciar todos los servicios"
    echo "12) Comandos para el VPS del túnel"
    echo "13) Backup"
    echo " 0) Salir"
    echo "---------------------------------"
    read -rp "Opción: " op
    echo
    case $op in
        1) agregar_ip ;;
        2) ver_ips ;;
        3) eliminar_ip ;;
        4) limpiar_duplicados ;;
        5) agregar_dominio ;;
        6) comprobar_dominio ;;
        7) ver_dominios ;;
        8) reiniciar_dnsmasq ;;
        9) cambiar_pass ;;
        10) estado ;;
        11) reiniciar ;;
        12) comandos_tunel ;;
        13) menu_backup; continue ;;
        0) exit 0 ;;
        *) echo "Opción no válida." ;;
    esac
    pausa
done
